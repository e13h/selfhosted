## {{ ansible_managed }}
## smb.conf managed by the samba_share role -- do not edit by hand.

[global]
   workgroup = {{ samba_workgroup }}
   server string = {{ samba_server_string }}
   security = {{ samba_security }}
   map to guest = {{ samba_map_to_guest }}

   # macOS (SMB3 + fruit VFS) compatibility. Fixes resource-fork/xattr
   # noise (._* files, .DS_Store weirdness) and speeds up Finder browsing.
   min protocol = SMB2
   vfs objects = {{ samba_vfs_objects }}
   fruit:metadata = {{ samba_fruit_metadata }}
   fruit:model = {{ samba_fruit_model }}
   fruit:posix_rename = yes
   fruit:veto_appledouble = no
   fruit:nfs_aces = no
   fruit:wipe_intentionally_left_blank_rfork = yes
   fruit:delete_empty_adfiles = yes

   # Quality-of-life / logging
   log file = /var/log/samba/log.%m
   max log size = 1000
   logging = file
   panic action = /usr/share/samba/panic-action %d

   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes

{% for share in samba_shares %}
[{{ share.name }}]
   path = {{ share.path }}
   comment = {{ share.comment | default('') }}
   browseable = yes
   read only = {{ 'yes' if share.read_only | default(false) else 'no' }}
   guest ok = {{ 'yes' if share.guest_ok | default(false) else 'no' }}
{% if share.valid_users is defined and share.valid_users | length > 0 %}
   valid users = {{ share.valid_users | join(', ') }}
{% endif %}
   create mask = {{ share.create_mask | default('0664') }}
   directory mask = {{ share.directory_mask | default('0775') }}
{% if share.owner is defined %}
   force user = {{ share.owner }}
{% endif %}
{% if share.group is defined %}
   force group = {{ share.group }}
{% endif %}

{% endfor %}
